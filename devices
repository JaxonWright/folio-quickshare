#!/bin/sh
# Lists the devices visible to Quick Share right now. Folio runs this every
# few seconds whether or not a menu is open, so it only listens: without
# --no-wake each poll would wake Quick Share on every phone in range.
# A device goes by its name, which send --to takes, because its id is an
# address that changes from one connection to the next.
. ./lib.sh
qs=$(quickshare_bin) || exit 1
"$qs" --json browse --timeout 2 --no-wake | jq -sc '
  [.[] | select(.t == "device" and (.name // "") != "")
       | {id: .name, name: .name, icon: "quickshare.svg"}]
  | {items: unique_by(.id)}'
