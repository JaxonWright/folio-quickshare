#!/bin/sh
# receive on <folder>: receive with Quick Share into the folder until turned
# off, across logins. receive off: stop.
. ./lib.sh
# quickshare receive's default port, which phones connect to.
port=53318

case $1 in
  on)
    dir=$2
    qs=$(quickshare_bin 2>&1) || {
      jq -cn --arg why "$qs" '{error: ["Couldn'\''t get quickshare: %1", $why]}'
      exit 1
    }
    failing() { "$qs" --json doctor --dir "$dir" | jq -c 'select(.status == "fail")'; }
    fails=$(failing)
    # A firewall that drops the phone's connection fails without a word on
    # this side. ufw is opened with the rule doctor suggests, after the
    # desktop's password prompt; when that is cancelled, or the firewall is
    # something else, doctor's fix is shown instead.
    if printf '%s' "$fails" | jq -e 'select(.name == "firewall")' >/dev/null && ufw=$(command -v ufw); then
      pkexec "$ufw" allow "$port/tcp" comment quickshare >/dev/null 2>&1 && fails=$(failing)
    fi
    problem=$(printf '%s\n' "$fails" | jq -r '"\(.detail)\(if .fix != "" then "; \(.fix)" else "" end)"' | head -n 1)
    if [ -n "$problem" ]; then
      jq -cn --arg why "$problem" '{error: ["Can'\''t receive with Quick Share: %1", $why]}'
      exit 1
    fi
    mkdir -p "$state" "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" || exit 1
    printf '%s\n' "$dir" >"$state/dir"
    # systemd reads % as a specifier, so a literal one is doubled.
    cat >"${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit" <<EOF
[Unit]
Description=Receive files with Quick Share for Folio
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart="$(printf '%s' "$PWD" | sed 's/%/%%/g')/receiver"
Restart=on-failure

[Install]
WantedBy=graphical-session.target
EOF
    systemctl --user daemon-reload &&
      systemctl --user enable --quiet "$unit" &&
      systemctl --user restart "$unit" || exit 1
    jq -cn --arg name "$(basename "$dir")" '{notice: ["Receiving with Quick Share into %1.", $name]}'
    ;;
  off)
    systemctl --user disable --now --quiet "$unit" || exit 1
    echo '{"notice": "Stopped receiving with Quick Share."}'
    ;;
esac
